      "position": [
        440,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "message",
              "value": "={{ '📐 Changement de schema dbt detecte — modele: ' + ($json.model || 'inconnu') + ', type: ' + ($json.change_type || 'inconnu') + ' (' + $now.toISO() + ')' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "noop1",
      "name": "Notification prete (brancher CI GitHub Actions + Slack ici)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        680,
        300
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Declenchement": {
      "main": [
        [
          {
            "node": "Formater notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Formater notification": {
      "main": [
        [
          {
            "node": "Notification prete (brancher CI GitHub Actions + Slack ici)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
