{
  "name": "Notification changement de schema dbt",
  "nodes": [
    {
      "id": "trig1",
      "name": "Declenchement",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "5b6c7d8e-9f0a-4b1c-8d2e-3f4a5b6c7d8e",
      "parameters": {
        "path": "trigger-schema-change",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "set1",
      "name": "Formater notification",
      "type": "n8n-nodes-base.set",
