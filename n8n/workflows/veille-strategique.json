        "language": "javaScript",
        "jsCode": "const news = $('Actualites tech-IA').first().json.hits.map(h => '- ' + h.title).join('\\n');\nconst fx = $('Taux de change').first().json.rates;\nconst fxLine = Object.entries(fx).map(([k,v]) => k + '=' + v).join(', ');\nconst digest = 'Actualites tech/IA (Hacker News) :\\n' + news + '\\n\\nTaux de change EUR -> ' + fxLine;\nreturn [{ json: { digest_brut: digest } }];"
      }
