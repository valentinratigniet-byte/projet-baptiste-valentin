MYSQL_ROOT_PASSWORD=changeme
MYSQL_USER=crm_user
MYSQL_PASSWORD=changeme

MONGO_USER=mongo_admin
MONGO_PASSWORD=changeme

MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=changeme123

POSTGRES_DB=dbt_dev
POSTGRES_USER=dbt_user
POSTGRES_PASSWORD=changeme

# Compte owner n8n (créé une fois via /rest/owner/setup, cf. docs/ARCHITECTURE.md)
N8N_ADMIN_EMAIL=admin@bv-dataplatform.local
N8N_ADMIN_PASSWORD=changeme

# Sel d'anonymisation RGPD (data-contracts/ingest_to_bronze.py) - à changer, ne jamais commit la vraie valeur
ANONYMIZATION_SALT=changeme-salt

# BigQuery (prod target dbt) - clé hors repo (ex: ~/.gcp/<projet>-dbt-loader.json),
# jamais dans le dossier projet, jamais commit.
# BQ_KEYFILE et pas GOOGLE_APPLICATION_CREDENTIALS : ce nom standard peut être
# déjà positionné de façon persistante sur la machine pour un autre projet GCP
# (variable d'environnement Windows/Unix globale) et écraserait silencieusement
# la valeur du .env. Voir docs/GOUVERNANCE.md.
BQ_KEYFILE=
BQ_PROJECT=
BQ_DATASET=marts
