{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dim_compte",
  "type": "object",
  "required": ["compte_id", "code_compte", "libelle", "nature"],
  "additionalProperties": false,
  "properties": {
    "compte_id": {"type": "integer", "minimum": 1},
    "code_compte": {"type": "string", "pattern": "^[0-9]{4}$"},
    "libelle": {"type": "string", "minLength": 1},
    "nature": {"type": "string", "enum": ["charge", "produit"]}
  }
}
