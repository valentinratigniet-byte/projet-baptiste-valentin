{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "app_events",
  "type": "object",
  "required": ["timestamp", "event_type", "niveau", "client_id", "session_id", "user_agent"],
  "additionalProperties": false,
  "properties": {
    "timestamp": {"type": "string"},
    "event_type": {"type": "string", "enum": ["login", "view_product", "add_to_cart", "purchase_attempt", "purchase_success", "error"]},
    "niveau": {"type": "string", "enum": ["info", "warning", "error"]},
    "client_id": {"type": "integer", "minimum": 1},
    "session_id": {"type": "string", "minLength": 1},
    "user_agent": {"type": "string", "minLength": 1},
    "produit_id": {"type": "integer", "minimum": 1},
    "message": {"type": "string", "minLength": 1}
  }
}
