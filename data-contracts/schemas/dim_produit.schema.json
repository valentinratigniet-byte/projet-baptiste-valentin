{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dim_produit",
  "type": "object",
  "required": ["produit_id", "code", "libelle", "famille"],
  "additionalProperties": false,
  "properties": {
    "produit_id": {"type": "integer", "minimum": 1},
    "code": {"type": "string", "pattern": "^PRD[0-9]{4}$"},
    "libelle": {"type": "string", "minLength": 1},
    "famille": {"type": "string", "enum": ["Électronique", "Mobilier", "Textile", "Alimentaire", "Cosmétique"]}
  }
}
