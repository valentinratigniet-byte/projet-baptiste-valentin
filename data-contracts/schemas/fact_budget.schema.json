{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "fact_budget",
  "type": "object",
  "required": ["budget_id", "periode", "centre_cout_id", "compte_id", "version_id", "montant_budget"],
  "additionalProperties": false,
  "properties": {
    "budget_id": {"type": "integer", "minimum": 1},
    "periode": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "centre_cout_id": {"type": "integer", "minimum": 1},
    "compte_id": {"type": "integer", "minimum": 1},
    "version_id": {"type": "integer", "minimum": 1},
    "montant_budget": {"type": "number", "exclusiveMinimum": 0}
  }
}
