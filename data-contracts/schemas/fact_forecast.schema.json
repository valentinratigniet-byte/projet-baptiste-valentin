{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "fact_forecast",
  "type": "object",
  "required": ["forecast_id", "periode_cible", "date_revision", "centre_cout_id", "compte_id", "montant_forecast"],
  "additionalProperties": false,
  "properties": {
    "forecast_id": {"type": "integer", "minimum": 1},
    "periode_cible": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "date_revision": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "centre_cout_id": {"type": "integer", "minimum": 1},
    "compte_id": {"type": "integer", "minimum": 1},
    "montant_forecast": {"type": "number", "exclusiveMinimum": 0}
  }
}
