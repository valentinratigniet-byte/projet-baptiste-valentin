{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dim_client",
  "type": "object",
  "required": ["client_id", "code", "libelle", "segment"],
  "additionalProperties": false,
  "properties": {
    "client_id": {"type": "integer", "minimum": 1},
    "code": {"type": "string", "pattern": "^CLI[0-9]{5}$"},
    "libelle": {"type": "string", "minLength": 1},
    "segment": {"type": "string", "enum": ["Grand compte", "PME", "Particulier", "Revendeur"]}
  }
}
