{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "fact_ventes_reel",
  "type": "object",
  "required": ["vente_id", "date", "centre_cout_id", "compte_id", "produit_id", "client_id", "montant_reel", "quantite"],
  "additionalProperties": false,
  "properties": {
    "vente_id": {"type": "integer", "minimum": 1},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "centre_cout_id": {"type": "integer", "minimum": 1},
    "compte_id": {"type": "integer", "minimum": 1},
    "produit_id": {"type": "integer", "minimum": 1},
    "client_id": {"type": "integer", "minimum": 1},
    "montant_reel": {"type": "number", "exclusiveMinimum": 0},
    "quantite": {"type": "integer", "minimum": 1}
  }
}
